@startuml EVCN_StateMachine
title Charging Station — State Machine (per connector)

[*] --> Idle

state Idle {
  Idle : entry / open contactors, status LED green
  Idle : "Online, no vehicle plugged"
}

state Authenticating {
  Authenticating : entry / display "Authenticate"
  Authenticating : exit / record auth method
}

state Negotiating {
  Negotiating : entry / OCPP TransactionEvent (Started)
  Negotiating : "ISO 15118 SECC handshake or basic AC handshake"
}

state Charging {
  Charging : entry / close contactors, start meter
  Charging : do / publish MeterValues every 30 s
  Charging : exit / open contactors
}

state Pausing {
  Pausing : "Throttle from DR signal\nor target SoC reached"
  Pausing : do / reduce setpoint, hold contactors closed
}

state Ending {
  Ending : entry / soft-stop ramp
  Ending : exit / OCPP TransactionEvent (Ended), settle billing
}

state Fault {
  Fault : entry / open contactors within 100 ms
  Fault : entry / OCPP StatusNotification(Faulted)
  Fault : "Ground fault, overtemp, contactor weld, comms loss > 24 h"
}

state Maintenance {
  Maintenance : "Operator-initiated lockout"
  Maintenance : do / reject all sessions
}

Idle --> Authenticating         : Plug detected (CP state B)
Authenticating --> Negotiating  : Auth OK
Authenticating --> Idle         : Timeout 60 s / Auth fail
Negotiating --> Charging        : Handshake OK
Negotiating --> Fault           : Handshake fail
Charging --> Pausing            : DR signal / target SoC
Pausing --> Charging            : Resume signal
Charging --> Ending             : User stop / EV stop / Operator remote stop
Pausing --> Ending              : User stop
Ending --> Idle                 : Unplug
Charging --> Fault              : Fault detected
Pausing --> Fault               : Fault detected

Idle --> Maintenance            : Operator lockout
Maintenance --> Idle            : Operator unlock
Fault --> Maintenance           : Operator dispatch
Maintenance --> Idle            : Repaired & cleared

Fault --> [*]                   : Decommission
Maintenance --> [*]             : Decommission

@enduml
