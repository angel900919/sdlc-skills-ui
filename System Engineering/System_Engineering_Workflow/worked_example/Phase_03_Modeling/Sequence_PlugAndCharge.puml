@startuml EVCN_Sequence_PnC
title Sequence Diagram — ISO 15118 Plug & Charge (Happy Path)

actor "EV Driver" as D
participant "EV (EVCC)" as EV
participant "Station (SECC)" as ST
participant "CSMS" as CS
participant "Contract CA" as CA
participant "Payment Service" as PS

D -> ST   : Plug in
ST -> EV  : SLAC PLC link establish
EV -> ST  : SupportedAppProtocolReq (ISO 15118-20)
ST -> EV  : SupportedAppProtocolRes
EV -> ST  : SessionSetupReq
ST -> EV  : SessionSetupRes (sessionID)
EV -> ST  : ServiceDiscoveryReq
ST -> EV  : ServiceDiscoveryRes (PnC, AC/DC)
EV -> ST  : AuthorizationSetupReq
ST -> EV  : AuthorizationSetupRes (PnC supported)
EV -> ST  : AuthorizationReq (signed contract certificate)
ST -> CS  : Authorize.req (idToken=eMAID, certChain)
CS -> CA  : OCSP / certificate-status
CA --> CS : Good
CS -> ST  : Authorize.conf (Accepted)
ST -> EV  : AuthorizationRes (Accepted)
EV -> ST  : ChargeParameterDiscoveryReq
ST -> EV  : ChargeParameterDiscoveryRes (limits)
EV -> ST  : ScheduleSelectionReq
ST -> EV  : ScheduleSelectionRes
EV -> ST  : PowerDeliveryReq (Start)
ST -> CS  : TransactionEvent.req (Started)
CS -> ST  : TransactionEvent.conf
ST -> EV  : PowerDeliveryRes (Accepted)

note over ST, EV
  Energy delivery starts.
  Loop: MeterValues every 30 s.
end note

loop every 30 s while charging
  ST -> CS : MeterValues.req
  CS -> ST : MeterValues.conf
end

D -> ST   : Press Stop (or EV terminates)
EV -> ST  : PowerDeliveryReq (Stop)
ST -> EV  : PowerDeliveryRes
ST -> CS  : TransactionEvent.req (Ended, kWh)
CS -> PS  : Settle (eMAID -> contract holder)
PS --> CS : Settled (txID)
CS -> ST  : TransactionEvent.conf
ST -> D   : Receipt (push + HMI)

@enduml
