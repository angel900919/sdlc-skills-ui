@startuml EVCN_Requirements
title Requirements Diagram — derive / refine / satisfy / verify

skinparam class {
  BackgroundColor #FDF7E5
  BorderColor #8A6E2F
}

class "<<requirement>>\nREQ-F-03\nStart energy ≤ 10 s after auth" as F03
class "<<requirement>>\nREQ-F-03.1\nOCPP Authorize ≤ 1 s" as F03_1
class "<<requirement>>\nREQ-F-03.2\nContactor close ≤ 200 ms" as F03_2
class "<<requirement>>\nREQ-INT-01\nWSS to CSMS, RTT < 500 ms" as INT01

class "<<requirement>>\nREQ-F-04\nE-Stop opens contactors ≤ 100 ms" as F04
class "<<requirement>>\nREQ-P-06\nGFCI trip ≤ 100 ms" as P06

class "<<requirement>>\nREQ-SEC-01\nTLS 1.3 + cert pinning" as SEC01
class "<<requirement>>\nREQ-SEC-02\nDevice cert in TPM" as SEC02

class "<<block>>\nStation Controller" as Controller
class "<<block>>\nPower Electronics" as Power
class "<<block>>\nNetwork Comms" as Comms

class "<<testCase>>\nTC-VER-03\nMeasure auth-to-energy timing" as TC03
class "<<testCase>>\nTC-VER-04\nE-Stop oscilloscope test" as TC04
class "<<testCase>>\nTC-VER-08\nTLS scanner + cert pin check" as TC08

F03 ..> F03_1 : <<refine>>
F03 ..> F03_2 : <<refine>>
F03 ..> INT01 : <<derive>>
F04 ..> P06   : <<refine>>

Controller ..> F03   : <<satisfy>>
Power      ..> F04   : <<satisfy>>
Comms      ..> SEC01 : <<satisfy>>
Controller ..> SEC02 : <<satisfy>>

TC03 ..> F03   : <<verify>>
TC04 ..> F04   : <<verify>>
TC08 ..> SEC01 : <<verify>>

@enduml
