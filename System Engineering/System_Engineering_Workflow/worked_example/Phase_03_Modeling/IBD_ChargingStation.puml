@startuml EVCN_IBD_Station
title Internal Block Diagram — Charging Station (EVSE)

skinparam component {
  BackgroundColor #F4F8FB
  BorderColor #2A5C82
}

' Ports on the station boundary
component "Charging Station (EVSE)" as Station {

  port "AC Mains In\n(3-phase 480 V)"        as P_ACIN
  port "Connector Out\n(CCS / NACS)"          as P_CONN
  port "Cellular / Ethernet"                  as P_NET
  port "User Touch / RFID / EMV"              as P_HMI
  port "E-Stop"                               as P_ESTOP
  port "Ground / PE"                          as P_PE

  component "Power Electronics" as PE {
    component "AC/DC Rectifier (SiC)" as Rect
    component "DC/DC Buck-Boost"      as DCDC
    component "Contactor Bank"        as Cont
    component "Filter / EMI"          as EMI
    component "Energy Meter (IEC 62053)" as Meter
  }

  component "Station Controller" as SC {
    component "Charge Control SM" as CSM
    component "OCPP 2.0.1 Stack"   as OCPP
    component "ISO 15118 Stack"    as ISO
    component "Secure Element (TPM)" as TPM
    component "Local Log Buffer (24 h)" as LOG
  }

  component "HMI" as HMI {
    component "10\" Touch Display" as Disp
    component "RFID Reader (NFC-A)" as RFID
    component "EMV Contactless Terminal (P2PE)" as EMV
    component "Status LED Ring" as LED
  }

  component "Comms Module" as CM {
    component "LTE / 5G Modem" as LTE
    component "1 GbE PHY" as ETH
    component "MQTT Bridge" as MQTT
  }
}

' Internal connections
P_ACIN  --> EMI    : "AC power"
EMI     --> Rect   : "filtered AC"
Rect    --> DCDC   : "high-voltage DC bus"
DCDC    --> Cont   : "regulated DC"
Cont    --> Meter  : "switched output"
Meter   --> P_CONN : "metered DC to vehicle"
P_PE    --> Cont   : "ground bond"

P_ESTOP --> Cont   : "hard-wired open"
P_ESTOP --> CSM    : "fault signal"

CSM <--> OCPP
CSM <--> ISO
OCPP <--> TPM     : "client cert sign"
OCPP --> LOG      : "events"
OCPP <--> MQTT
ISO  <--> P_CONN  : "PLC HomePlug GP\n(via signal coupler in connector)"

CM   --> P_NET
OCPP --> CM       : "WSS to CSMS"

HMI --> P_HMI
Disp <--> CSM     : "session UI"
RFID --> CSM      : "auth tag"
EMV  --> CM       : "tokenized payment\n(PCI scope kept off SC)"
LED  <-- CSM      : "status"

@enduml
