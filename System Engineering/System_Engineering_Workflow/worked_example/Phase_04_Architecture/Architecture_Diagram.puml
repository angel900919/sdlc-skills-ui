@startuml EVCN_Architecture
title EVCN — System Architecture (TOGAF-lite, 4 categories + Cloud + External)

skinparam component {
  BackgroundColor #F4F8FB
  BorderColor #2A5C82
}
skinparam package {
  BackgroundColor #FFFFFF
  BorderColor #5C8CA8
}

package "Edge — Charging Site" {
  package "Stations (1..N)" {
    component "Charging Station\n(EVSE)" as Station {
      component "Power Electronics" as PE
      component "Station Controller\n(OCPP/ISO15118)" as SC
      component "HMI\n(Touch + RFID + EMV)" as HMI
      component "Comms (LTE/Eth)" as CM
    }
  }
  component "Site Energy Management\n(Load balancing, sub-metering)" as SEM
  component "Site Gateway\n(VPN + firewall)" as SGW
}

package "Cloud — Backend Services (Kubernetes)" {
  component "OCPP CSMS" as CSMS
  component "Identity / OIDC\n(Keycloak)" as IAM
  component "Session Service" as SESS
  component "Billing & Settlement" as BILL
  component "Tariff Engine" as TARIFF
  component "DR Orchestrator\n(OpenADR VTN client)" as DR
  component "OCPI Hub" as OCPI
  component "Telemetry / Observability\n(Prom + Grafana + Loki)" as OBS
  database  "PostgreSQL\n(sessions, users)" as PG
  database  "S3\n(logs, firmware)" as S3
  queue     "Kafka\n(events)" as KAFKA
}

package "Clients" {
  component "Driver Mobile App\n(Flutter, iOS/Android)" as APP
  component "Web Portal\n(React)" as WEB
  component "Operator Dashboard\n(React)" as OPS
  component "Technician Tool\n(local + cloud)" as TECH
}

package "External Systems" {
  cloud  "Utility / DR Server\n(OpenADR VTN)" as UTIL
  cloud  "Payment Processor\n(Stripe / Adyen)" as PSP
  cloud  "Roaming Partners (MSPs)" as MSP
  cloud  "Map Apps\n(Google / Apple)" as MAP
  cloud  "Contract Cert Authority\n(V2G PKI)" as CCA
}

' Edge connections
SC --> PE        : "control / metering"
HMI --> SC
CM --> SC
SC --> CM        : "OCPP 2.0.1 over WSS"
CM --> SGW
SGW --> CSMS     : "TLS 1.3"
SEM <--> SC      : "Modbus TCP, dynamic load"

' Cloud internal
CSMS <--> SESS
SESS --> KAFKA
SESS <--> PG
BILL <--> PG
TARIFF <--> PG
CSMS <--> IAM
DR --> CSMS      : "throttle commands"
OCPI <--> SESS
OCPI <--> BILL
OBS <-- CSMS
OBS <-- SESS
OBS <-- BILL

' Client connections
APP  --> IAM     : "OIDC"
APP  --> SESS    : "REST + WSS"
WEB  --> SESS
OPS  --> SESS
OPS  --> BILL
OPS  --> TARIFF
OPS  --> OBS
TECH --> CSMS    : "diagnostics OCPP"

' External connections
UTIL --> DR      : "OpenADR 2.0b signals"
PSP <--> BILL    : "settle, refund"
MSP <--> OCPI    : "OCPI 2.2.1 sessions/CDRs"
MAP <-- SESS     : "public availability API"
CCA <--> CSMS    : "OCSP for PnC certs"

@enduml
