dashboard/state.json

# Generated coherence snapshot — /coherence-check writes its findings here for
# the dashboard drift panel; derived output, regenerated each run.
dashboard/coherence.json

# mtdd runtime cycle state — one-cycle scratch written by /mtdd-cycle (the
# orchestrator). Unlike .mtdd/config (shared, committed), this is per-run state.
.mtdd/cycle-state
