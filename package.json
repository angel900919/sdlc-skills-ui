{
  "name": "sdlc-command-center",
  "version": "0.1.0",
  "private": true,
  "description": "AI-powered SDLC Command Center — visual operating system over Claude Code CLI and the .claude/skills chain",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "postinstall": "chmod +x node_modules/node-pty/prebuilds/*/spawn-helper 2>/dev/null || true",
    "dev": "npm-run-all --parallel dev:server dev:web",
    "dev:server": "npm run dev --workspace apps/server",
    "dev:web": "npm run dev --workspace apps/web",
    "build": "npm run build --workspace packages/shared --if-present && npm run build --workspace apps/server --if-present && npm run build --workspace apps/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "test:watch": "vitest",
    "start": "npm run start --workspace apps/server"
  },
  "devDependencies": {
    "npm-run-all": "^4.1.5",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  },
  "engines": {
    "node": ">=20"
  }
}
